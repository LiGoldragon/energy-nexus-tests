  Configuration ]                                         ; effective independently versioned readback
[ Configured.ConfigurationChange                          ; only after owner persistence succeeds
  Configuration.ConfigurationSnapshot                     ; both or explicitly partial parts
  Refused.Failure ]                                       ; bounded typed failure
[ Call.{ Caller Query } ]                                 ; public meta envelope
